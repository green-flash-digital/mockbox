{
  "name": "mockingjson",
  "description": "A simple utility to mock tabular data",
  "packageManager": "yarn@4.6.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "yarn tsc --project tsconfig.build.json",
    "deploy": "yarn wrangler pages deploy",
    "dev": "yarn wrangler pages dev",
    "seed": "yarn tsx ./scripts/seed.ts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/types.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/green-flash-digital/mockbox.git"
  },
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/green-flash-digital/mockbox/issues"
  },
  "homepage": "https://github.com/green-flash-digital/mockbox#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250204.0",
    "@ngneat/falso": "7.3.0",
    "@types/node": "22.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "wrangler": "3.108.1"
  }
}
